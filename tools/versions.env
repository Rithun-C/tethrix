# One place for every pinned tool version. Read by the Makefile and by CI.
#
# Images are pinned by digest (the sha256 value), not only by tag. A tag can be moved to
# point at different content; a digest is the content's fingerprint and cannot change.
# The tag is kept in the name only so a human can see the version.
#
# To update a tool: follow docs/dependency-policy.md, section "Updating a scanner".
# Format: KEY=value with no quotes and no spaces, so both make and a shell can read it.
#
# Checked on 2026-11-15 against each project's official GitHub releases page.

# https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

# https://github.com/terraform-linters/tflint/releases/tag/v0.66.0
TFLINT_IMAGE=ghcr.io/terraform-linters/tflint:v0.66.0@sha256:65b9944a9274c4989492c1d79998c2801664bf8a55fddb4bd3a9e6d73a006ddc

# https://github.com/bridgecrewio/checkov/releases/tag/3.4.5
CHECKOV_IMAGE=bridgecrew/checkov:3.4.5@sha256:122602cf32cc72286155d39f1f234b7b594818f7b8d7fdf490701620e521368b

# https://github.com/semgrep/semgrep/releases/tag/v1.185.0
SEMGREP_IMAGE=semgrep/semgrep:1.185.0@sha256:67518c174185a2043fdbed16c70631b79209499b3671178e7194379b48295a0d

# https://github.com/aquasecurity/trivy/releases/tag/v0.76.2
TRIVY_IMAGE=aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb

# https://pypi.org/project/pre-commit/4.7.0/ (installed with uv, see `make hooks`)
PRE_COMMIT_VERSION=4.7.0

# Terraform used in CI. Keep it equal to the version on the laptop (`terraform version`).
TERRAFORM_VERSION=1.15.8
