# npm settings for this project. They apply to every `npm` command run in this folder.

# Packages may not run their own install scripts. An install script is code that runs
# on your machine the moment a package is installed; it is the main way npm worms
# spread. None of our packages needs one.
ignore-scripts=true

# `npm install <name>` writes the exact version, not a range like ^1.2.3 (SR-80).
save-exact=true

# Cooldown: ignore versions published in the last 7 days. Most malicious releases are
# found and removed within days.
min-release-age=7

# Less noise in the output.
fund=false
update-notifier=false
