# Copy this file to backend.hcl (git ignores backend.hcl) and replace ACCOUNT_ID and NAME.
# The bucket name is the same one as in infra/bootstrap/backend.hcl. Used with:
#   terraform init -backend-config=backend.hcl

bucket       = "productivity-app-tfstate-ACCOUNT_ID"
key          = "labs/NAME/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
